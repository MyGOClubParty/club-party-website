{
  "name": "club-party-website",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "start": "docusaurus start",
    "prebuild": "node scripts/check-md-residue.mjs",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc && tsc -p worker/tsconfig.json",
    "check:md": "node scripts/check-md-residue.mjs",
    "gen:clubs": "node scripts/gen-club-placeholders.mjs && node scripts/gen-club-docs.mjs",
    "cf:types": "wrangler types worker/worker-configuration.d.ts --include-runtime false",
    "cf:preview": "npm run build && wrangler dev --var TURNSTILE_SECRET:1x0000000000000000000000000000000AA",
    "cf:dev": "wrangler dev --ip 0.0.0.0 --port 3000 --var TURNSTILE_SECRET:1x0000000000000000000000000000000AA",
    "cf:dry-run": "wrangler deploy --dry-run",
    "cf:deploy": "npm run build && wrangler deploy",
    "db:migrate:local": "wrangler d1 execute club-party-db --local --file=worker/schema.sql",
    "db:migrate:remote": "wrangler d1 execute club-party-db --remote --file=worker/schema.sql",
    "db:migrate:college:local": "wrangler d1 execute club-party-db --local --file=worker/migrate-add-college.sql",
    "db:migrate:college:remote": "wrangler d1 execute club-party-db --remote --file=worker/migrate-add-college.sql",
    "db:query:local": "wrangler d1 execute club-party-db --local --command=\"SELECT id, student_id, name, college, class_name, mc_id, skin_key, created_at FROM participants ORDER BY created_at DESC\""
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@iicemeta/minecraft-react-ui": "^1.0.2",
    "@mdx-js/react": "^3.0.0",
    "clsx": "^2.0.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261013.1",
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "~6.0.2",
    "wrangler": "^4.149.0"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=20.0"
  },
  "allowScripts": {
    "@swc/core@1.16.13": true,
    "core-js@3.50.0": true
  }
}
