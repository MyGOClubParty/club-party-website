// Cloudflare Workers 部署配置（静态资产 + Worker 入口 + D1 + R2）。
//
// 依据的官方文档（2026-10-13 查）：
// - 静态资产总览        https://developers.cloudflare.com/workers/static-assets/
// - 配置与绑定          https://developers.cloudflare.com/workers/static-assets/binding/
// - SSG + 自定义 404    https://developers.cloudflare.com/workers/static-assets/routing/static-site-generation/
// - html_handling 语义  https://developers.cloudflare.com/workers/static-assets/routing/advanced/html-handling/
// - Docusaurus 专页     https://developers.cloudflare.com/workers/framework-guides/web-apps/more-web-frameworks/docusaurus/
//
// 三条决定，都是拿本站的 build 产物量出来的，不是照抄模板：
//
// 1. `directory: "./build"` —— Docusaurus 的输出目录（`.gitignore` 里已忽略）。
// 2. `html_handling: "drop-trailing-slash"` —— **不能**用默认的 `auto-trailing-slash`。
//    Docusaurus 生成的站内链接是 `href=/docs/intro`（无尾斜杠），而产物文件是
//    `build/docs/intro/index.html`（目录 + index）。默认值遇到 `/docs/intro` 会认成
//    「folder 但缺尾斜杠」→ **307 跳到 `/docs/intro/`**，于是站内每一次点击都多一跳。
//    `drop-trailing-slash` 下 `/docs/intro` 直接 200 命中 `docs/intro/index.html`，
//    与产物里的链接写法逐一对齐（`/docs/intro/` 反过来 307 回无斜杠）。
// 3. `not_found_handling: "404-page"` —— Docusaurus 会生成 `build/404.html`，
//    命中不到资产时回它，且**带 404 状态码**（不是 SPA 那种 200 + index.html）。
//
// `run_worker_first: ["/api/*"]` 是必需的：默认（`false`）是「先找静态资产，找不到才跑 Worker」，
// 而 compat date ≥ 2025-04-01 起**导航请求**（`Sec-Fetch-Mode: navigate`）在找不到资产时
// 也**不会**进 Worker，直接按 `not_found_handling` 回 404 页。不把 `/api/*` 列进去，
// 浏览器直接打开 `/api/health` 会拿到 404.html 而不是 JSON（curl 不带那个头，测不出差别）。
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "club-party-website",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-13",
  "assets": {
    "directory": "./build",
    "binding": "ASSETS",
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  // 报名数据。**建表不用手动跑**：第一个报名请求进来时 Worker 自己把表建起来
  // （`CREATE TABLE IF NOT EXISTS` 幂等，见 worker/db.ts 的 ensureSchema）。
  // `db:migrate:*` 仍然留着，但只用在两件事上：手动重建一个空库、以及给**老库补列**
  // （migrate-add-college.sql / migrate-add-skin-source.sql —— SQLite 的 ADD COLUMN 补不了
  // 已经存在但没有该列的表，那两件事只能手动做一次）。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "club-party-db",
      "database_id": "254dd607-b77f-41ab-a349-1dad25242ac6"
    }
  ],
  // 皮肤文件。对象键 = Minecraft 游戏 id + 学号后两位 + ".png"（见 worker/skin.ts）。
  // 桶不开公共访问，取图一律经 Worker 的 `/api/skins/<key>`。
  "r2_buckets": [
    {
      "binding": "SKINS",
      "bucket_name": "club-party"
    }
  ],
  // 线上日志。仪表盘里已经开了 Observability —— **这里必须跟着写**：Workers 的配置以
  // 代码/`wrangler.jsonc` 为准，只在仪表盘开、而配置里没有，下一次 `wrangler deploy` 会把它关掉。
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  // 限流（Workers Rate Limiting 绑定，见 worker/littleskin.ts 的 `handleSkinPreview`）。
  //
  // 只给 `/api/skin-preview` 用：它是全站唯一一条「公开、无需登录、还会替我们去打上游」的接口，
  // 一次调用 = 两次 LittleSkin 请求（`/texture/<tid>` + `/textures/<hash>`）。没有闸的话，
  // 谁都能把它当免费代理刷，同时把上游打到限流。
  //
  // ⚠️ 额度**不能按「一个人够用」来定**：教室出口是同一个 IP，几十号人同时预览会共用一个桶。
  // 所以取 120 次/分钟 —— 脚本刷起来是几千次，而一屋子人正常预览远到不了这个数。
  "ratelimits": [
    {
      "name": "SKIN_PREVIEW_LIMIT",
      "namespace_id": "20261017",
      "simple": {"limit": 120, "period": 60}
    },
    {
      // 管理员登录：同一个 IP 一分钟 10 次。口令是唯一的凭据，必须挡住爆破
      // （见 worker/admin.ts 的 `login`）。教室同一个出口 IP 也不会十几个人同时试后台口令。
      "name": "ADMIN_LOGIN_LIMIT",
      "namespace_id": "20261018",
      "simple": {"limit": 10, "period": 60}
    }
  ],
  // 人机校验（Turnstile，见 worker/turnstile.ts）。
  // 密钥**不进配置**：线上 `wrangler secret put TURNSTILE_SECRET`，本地由 `npm run cf:dev`
  // 用 `wrangler dev --var` 带上（刻意不用 `.dev.vars`，理由见 worker/env.d.ts）。这里只放
  // 可以公开的调项。
  "vars": {
    // 本站域名（逗号分隔，不带协议）。**留空 = 不核对域名归属**：widget 那边本来就只在
    // 自己注册过的域名上出票，这一层是「万一」用的。填了之后服务端会比对 siteverify 回来的
    // hostname，对不上就 403。注意只在真实密钥下生效（测试密钥回的 hostname 恒为 example.com）。
    "TURNSTILE_HOSTNAMES": "clubparty.iicemeta.com"
  }
}
